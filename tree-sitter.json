{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tree_sitter_sysmlv2",
      "camelcase": "TreeSitterSysMLv2",
      "title": "Tree Sitter SysMLv2",
      "scope": "source.tree_sitter_sysmlv2",
      "file-types": ["sysml"],
      "injection-regex": "^tree_sitter_sysmlv2$",
      "class-name": "TreeSitterTreeSitterSysmlv2"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "TreeSitter parser for Systems MOdelling Language Version 2",
    "authors": [
      {
        "name": "Benjamin Standfield",
        "email": "benjaminstandfield@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-tree_sitter_sysmlv2"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
