    "single_line_note": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "//"
        },
        {
          "type": "PATTERN",
          "value": "[^\\r\\n]*"
        }
      ]
    },
    "multiline_note": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "//*"
        },
        {
          "type": "PATTERN",
          "value": "(?:.|\\r|\\n)*?(?=\\*\\/)"
        },
        {
          "type": "STRING",
          "value": "*/"
        }
      ]
    },
    "regular_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/*"
          },
          {
            "type": "PATTERN",
            "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    },
    "comment_content": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "(?:.|\\r|\\n)*?(?=\\*\\/)"
      }
    },
    "name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "basic_name"
        },
        {
          "type": "SYMBOL",
          "name": "unrestricted_name"
        }
      ]
    },
    "basic_name": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "unrestricted_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "'(?:[^'\\\\]|\\\\[\\\\nyt\"'bf])*'"
      }
    },
    "decimal_value": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "exponential_value": {
      "type": "PATTERN",
      "value": "[0-9]+[eE][+-]?[0-9]+"
    },
    "string_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"(?:[^\"\\\\]|\\\\[\\\\nyt\"'bf])*\""
      }
    },
    "string_character": {
      "type": "PATTERN",
      "value": "[^\\p{C}\\\\\"]",
      "flags": "u"
    },
